{
  "name": "@typebase-io/docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next typegen && fumadocs-mdx && tsc --noEmit && prettier --check . && eslint .",
    "postinstall": "fumadocs-mdx"
  },
  "imports": {
    "#components/*": [
      "./src/components/*"
    ],
    "#collections/*": [
      "./.source/*"
    ],
    "#lib/*": [
      "./src/lib/*"
    ],
    "#mdx-components": [
      "./src/mdx-components.tsx"
    ],
    "#global-css": [
      "./src/app/global.css"
    ]
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "fumadocs-ui": "16.15.11",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
