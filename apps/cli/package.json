{
  "name": "@typebase-io/cli",
  "version": "0.1.6",
  "private": false,
  "type": "module",
  "description": "The CLI for Typebase. A type-safe backend you write as TypeScript files inside your existing app.",
  "license": "MIT",
  "homepage": "https://typebase.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typebase-io/monorepo.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/typebase-io/monorepo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "typebase",
    "typebase-io",
    "typescript",
    "backend",
    "cli",
    "api",
    "database",
    "auth",
    "drizzle",
    "better-auth",
    "orpc"
  ],
  "scripts": {
    "build": "node ../build-apps/src/index.ts build --app cli",
    "dev": "node src/index.ts",
    "lint": "tsc --build --noEmit && prettier --check . --ignore-path ../../.prettierignore && eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "bin": {
    "typebase-io-cli": "dist/esm/src/index.js",
    "typebase-io-cli-cjs": "dist/cjs/src/index.js"
  },
  "imports": {
    "#commands/*": [
      "./src/commands/*"
    ],
    "#helpers/*": [
      "./src/helpers/*"
    ],
    "#tests/*": [
      "./tests/*"
    ]
  },
  "dependencies": {
    "@commander-js/extra-typings": "catalog:",
    "@inquirer/prompts": "catalog:",
    "@neondatabase/api-client": "2.7.1",
    "auth": "1.6.11",
    "chalk": "catalog:",
    "commander": "catalog:",
    "dotenv": "17.4.2",
    "drizzle-kit": "1.0.0-beta.22",
    "drizzle-orm": "catalog:",
    "esbuild": "catalog:",
    "jiti": "2.7.0",
    "ora": "catalog:",
    "pg": "8.20.0",
    "preferred-pm": "5.0.0",
    "ts-morph": "27.0.2",
    "ts-pattern": "5.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "4.1.9",
    "better-auth": "catalog:",
    "vitest": "4.1.9",
    "yaml": "catalog:"
  },
  "files": [
    "dist"
  ]
}
