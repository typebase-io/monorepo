{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Configuration schema for Typebase project settings.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "projectPath": {
      "type": "string",
      "description": "Path to the Typebase project directory.",
      "minLength": 1
    },
    "serverProvider": {
      "type": "string",
      "enum": ["vercel", "cloudflare", "deno"],
      "description": "The server provider to deploy to."
    },
    "server": {
      "type": "object",
      "description": "Server build configuration.",
      "properties": {
        "output": {
          "type": "string",
          "enum": ["ts", "esm", "cjs"],
          "description": "The output format for the server build."
        },
        "adapter": {
          "type": "string",
          "enum": ["node", "bun", "cloudflare", "deno", "fastify", "hono"],
          "description": "The server adapter to use."
        },
        "embedded": {
          "type": "boolean",
          "default": false,
          "description": "Generate an embedded server for your application to mount. Defaults to false."
        },
        "outDir": {
          "type": "string",
          "description": "The output directory for the server build.",
          "minLength": 1
        },
        "actionsPath": {
          "type": "string",
          "description": "The path an embedded server serves your actions at.",
          "minLength": 1
        },
        "authPath": {
          "type": "string",
          "description": "The path an embedded server serves auth at.",
          "minLength": 1
        },
        "storagePath": {
          "type": "string",
          "description": "The path an embedded server serves local storage files at, when generated with `--local-storage`.",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "description": "The port the generated server listens on."
        }
      },
      "additionalProperties": false
    },
    "vercel": {
      "type": "object",
      "description": "Vercel deployment configuration.",
      "properties": {
        "projectId": {
          "type": "string",
          "description": "The Vercel project ID."
        },
        "projectName": {
          "type": "string",
          "description": "The Vercel project name."
        },
        "orgId": {
          "type": "string",
          "description": "The Vercel organization ID."
        }
      },
      "required": ["projectId", "projectName"],
      "additionalProperties": false
    },
    "cloudflare": {
      "type": "object",
      "description": "Cloudflare deployment configuration.",
      "properties": {
        "accountId": {
          "type": "string",
          "description": "The Cloudflare account ID."
        },
        "workerName": {
          "type": "string",
          "description": "The Cloudflare Worker name."
        },
        "subdomain": {
          "type": "string",
          "description": "The Cloudflare Workers subdomain."
        }
      },
      "required": ["accountId", "workerName", "subdomain"],
      "additionalProperties": false
    },
    "deno": {
      "type": "object",
      "description": "Deno Deploy configuration.",
      "properties": {
        "org": {
          "type": "string",
          "description": "The Deno Deploy organization."
        },
        "projectId": {
          "type": "string",
          "description": "The Deno Deploy project ID."
        },
        "slug": {
          "type": "string",
          "description": "The Deno Deploy project slug."
        }
      },
      "required": ["org", "projectId", "slug"],
      "additionalProperties": false
    },
    "neon": {
      "type": "object",
      "description": "Neon database configuration.",
      "properties": {
        "orgId": {
          "type": "string",
          "description": "The Neon organization ID."
        },
        "projectId": {
          "type": "string",
          "description": "The Neon project ID."
        }
      },
      "required": ["orgId", "projectId"],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "description": "Storage configuration.",
      "properties": {
        "project": {
          "type": "string",
          "description": "The project part of every bucket name, frozen by the first bucket sync."
        },
        "vercel": {
          "type": "object",
          "description": "Vercel storage account.",
          "properties": {
            "orgId": {
              "type": "string",
              "description": "The Vercel team that holds the Blob stores."
            }
          },
          "required": ["orgId"],
          "additionalProperties": false
        },
        "cloudflare": {
          "type": "object",
          "description": "Cloudflare storage account.",
          "properties": {
            "accountId": {
              "type": "string",
              "description": "The Cloudflare account that holds the R2 buckets."
            }
          },
          "required": ["accountId"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "description": "Anonymous usage data configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Send anonymous usage data about the commands you run. Defaults to true."
        },
        "noticeShown": {
          "type": "boolean",
          "description": "Whether the CLI has already shown the telemetry notice. Set by the CLI."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
